{% extends 'base.html.twig' %}
{% block title%}Images{% endblock %}
{% block images%}
<!-- Principal Content Start -->
<div id="images">
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            <h1>Images</h1>
            {{ form(form, {'attr': {'class':'form-horizontal'}}) }}
            <hr class="divider">

            <table class="table">
                <thead>
                    <tr>
                        <th scope="col">#</th>
                        <th scope="col">Image</th>
                    </tr>
                </thead>
                <tbody>
                    {% for image in images %}
                    <tr>
                        <th scope="row">{{ image.id }}</th>
                        <td>
                            <img src="{{ asset('images/index/gallery/' ~ image.file) }}" alt="{{ image.file }}"
                                style="max-width: 150px;">
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
<!-- Principal Content End -->
{% endblock %}