{% extends 'base.html.twig' %}

{% block blog %}
<!-- Principal Content Start -->
<div id="blog">
    <div class="container">
        <div class="row">

            <!-- Blocks of Posts -->
            <div class="col-xs-12 col-sm-8 row">
                {% for post in posts %}
                {{ include('blog/_post.html.twig', {'post': post}) }}
                {% else %}
                <p>No hi ha posts publicats.</p>
                {% endfor %}
            </div>
            <!-- End of Blog Post -->

            <!-- Side bar -->
            <div class="col-xs-12 col-sm-4">
                <form class="" action='{{ path('blog_buscar') }}'>
                    <input type="text" class="form-control" style="display:unset; width:85%" placeholder="Research"
                        name='searchTerm'>
                    <button type='submit' class="btn btn-primary btn-danger"><i class="fa fa-search"></i>
                    </button>
                </form>

                <div class="panel">
                    <div class="panel-heading">
                        <h4>Categories</h4>
                    </div>
                    <div class="panel-body">
                        <ul class="nav">
                            {% for category in categories %}
                            <li><a href="{{ path('blog') }}">{{ category.name }}</a></li>
                            {% else %}
                            <li>No hi ha categories.</li>
                            {% endfor %}
                        </ul>
                    </div>
                </div>
                <div class="well">
                    <h4>Soluta</h4>
                    <p>Quod soluta corrupti earum officia vel inventore vitae quidem, consequuntur odit impedit.</p>
                </div>
                <h3>Recent Posts</h3>
                <hr>
                {% for post in recents %}
                <div class="post">
                    <div class="post-heading">
                        {% if post.publishedAt %}
                        <span>{{ post.publishedAt|date('j F')|upper }}</span>
                        {% endif %}
                        <img class="img-responsive" src="{{ asset('images/blog/' ~ post.image) }}"
                            alt="{{ post.title }}">
                    </div>
                    <div class="post-body">
                        <h4 class="text-left">
                            <a href="#"><strong>{{ post.title }}</strong></a>
                        </h4>
                    </div>
                </div>
                {% else %}
                <p>Encara no hi ha cap post.</p>
                {% endfor %}
                <!-- End of Side bar -->

            </div>
        </div>
    </div>
    <!-- End of Principal Content Start -->
    {% endblock %}