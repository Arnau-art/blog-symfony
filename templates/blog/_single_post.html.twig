{% if not post %}
<h2>Post not found</h2>
{% else %}
<div class="post">
    <div class="post-heading">
        {% if post.publishedAt %}
        <span>{{ post.publishedAt|date('j F')|upper }}</span>
        {% endif %}
        <img class="img-responsive" src="{{ asset('images/blog/' ~ post.image) }}" alt="{{ post.title }}">
    </div>
    <div class="post-body">
        <h3><strong>{{ post.title }}</strong></h3>
        <hr>
        <p>{{ post.content }}</p>
        <p><small>Per {{ post.postUser.name }}</small></p>
    </div>
</div>

{{ include('partials/_post_comments.html.twig') }}
{% endif %}